{
  "datasets": [
    {
      "name": "688e0a06",
      "displayName": "fact_income_statement_metric_view",
      "asset_name": "operations.finance.fact_income_statement_metric_view"
    },
    {
      "name": "0622190f",
      "displayName": "testing_fact_income_statement",
      "queryLines": [
        "with base as (\r\n",
        "\r\n",
        "select \r\n",
        "\r\n",
        "    name_of_filing_company\r\n",
        "    ,name_of_submitted_form\r\n",
        "    ,reported_period\r\n",
        "    ,fiscal_year\r\n",
        "    ,fiscal_period\r\n",
        "    ,reported_quarters\r\n",
        "    ,terse_label\r\n",
        "    ,value\r\n",
        "\r\n",
        "    -- Previous 3 fiscal years\r\n",
        "    ,lag(fiscal_year,1) over (\r\n",
        "        partition by name_of_filing_company\r\n",
        "        order by reported_period\r\n",
        "    ) as prev_fiscal_year_1\r\n",
        "\r\n",
        "    ,lag(fiscal_year,2) over (\r\n",
        "        partition by name_of_filing_company\r\n",
        "        order by reported_period\r\n",
        "    ) as prev_fiscal_year_2\r\n",
        "\r\n",
        "    ,lag(fiscal_year,3) over (\r\n",
        "        partition by name_of_filing_company\r\n",
        "        order by reported_period\r\n",
        "    ) as prev_fiscal_year_3\r\n",
        "\r\n",
        "from operations.finance_staging.fact_staging_financial_statement \r\n",
        "\r\n",
        "where name_of_filing_company in ('NVIDIA CORP','INTEL CORP','QUALCOMM INC/DE','ADVANCED MICRO DEVICES INC','WALMART INC.')\r\n",
        "and financial_statement = 'IS'\r\n",
        "and reported_period = end_reported_period\r\n",
        "and value_segment is null\r\n",
        "and name_of_submitted_form in ('10-Q','10-K')\r\n",
        "and reported_quarters in (1,4) \r\n",
        "and terse_label in ('Revenues')--,'Revenue from Contract with Customer, Excluding Assessed Tax') \r\n",
        "\r\n",
        ")\r\n",
        "\r\n",
        "select\r\n",
        "\r\n",
        "    *\r\n",
        "\r\n",
        "    -- =====================================================\r\n",
        "    -- NORMALIZED CALENDAR YEAR\r\n",
        "    -- =====================================================\r\n",
        "\r\n",
        "    ,case\r\n",
        "\r\n",
        "        -- NVIDIA-style FY offset\r\n",
        "        when fiscal_period = 'FY'\r\n",
        "         and fiscal_year < prev_fiscal_year_1\r\n",
        "         and fiscal_year < prev_fiscal_year_2\r\n",
        "         and fiscal_year < prev_fiscal_year_3\r\n",
        "\r\n",
        "        then fiscal_year + 1\r\n",
        "\r\n",
        "        else fiscal_year\r\n",
        "\r\n",
        "    end as calendar_year\r\n",
        "\r\n",
        "from base\r\n",
        "order by reported_period asc"
      ]
    }
  ],
